# ── Camera ─────────────────────────────────────────────────────
CAMERA_SOURCE=0 # or 2 according to linux
MARKER_SIZE=0.10

# ── Camera Calibration (row-major, 9 values for 3x3 matrix) ────
CAM_MATRIX=600,0,320,0,600,240,0,0,1
DIST_COEFFS=0,0,0,0,0

# ── ArUco ──────────────────────────────────────────────────────
ARUCO_DICT=DICT_4X4_50
ORIGIN_ID=0
TRACKED_IDS=1,2,3

# ── Network ────────────────────────────────────────────────────
ROBOT_IP=192.168.1.100
ROBOT_PORT=5005
SEND_RATE_HZ=10
