# ── Camera ────────────────────────────────────────────────────────
CAMERA_INDEX=0
CALIBRATION_FILE=calibration.npz

# ── ArUco ─────────────────────────────────────────────────────────
ARUCO_DICT=DICT_4X4_50
MARKER_SIZE_M=0.04
TARGET_MARKER_ID=3
ROBOT_ID=5
# ── Arm Servos (PCA9685 channels) ─────────────────────────────────
SERVO_BASE=0
SERVO_SHOULDER=1
SERVO_ELBOW=2
SERVO_WRIST=3
SERVO_GRIPPER=4

# ── Servo limits (degrees) ────────────────────────────────────────
SERVO_MIN_DEG=0
SERVO_MAX_DEG=180

# ── Gripper ───────────────────────────────────────────────────────
GRIPPER_OPEN_DEG=60
GRIPPER_CLOSED_DEG=120

# ── Arm geometry (meters) ─────────────────────────────────────────
LINK_SHOULDER_M=0.105
LINK_ELBOW_M=0.105
LINK_WRIST_M=0.05

# ── IK offsets ────────────────────────────────────────────────────
BASE_HEIGHT_M=0.08
