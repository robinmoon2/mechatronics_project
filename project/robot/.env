# ── Camera ────────────────────────────────────────────────────────
CAMERA_INDEX=0
CALIBRATION_FILE=calibration.npz

# ── ArUco ─────────────────────────────────────────────────────────
ARUCO_DICT=DICT_4X4_50
MARKER_SIZE_M=0.04
TARGET_MARKER_ID=3
ROBOT_ID=5
# ── Arm Servos (PCA9685 channels) ─────────────────────────────────
SERVO_BASE=0
SERVO_SHOULDER=1
SERVO_ELBOW=2
SERVO_WRIST=3
SERVO_GRIPPER=4

#  Servo limits (degrees) 
SERVO_MIN_DEG=0
SERVO_MAX_DEG=180

#  Gripper 
GRIPPER_OPEN_DEG=60
GRIPPER_CLOSED_DEG=120

#  Arm geometry (meters) 
LINK_SHOULDER_M=0.105
LINK_ELBOW_M=0.105
LINK_WRIST_M=0.05

#  IK offsets 
BASE_HEIGHT_M=0.08

#  Server / Navigation 
HOST=0.0.0.0
PORT=5005
BUFFER_SIZE=4096
GPS_TIMEOUT=0.2
TARGET_IDS=1,4
PAUSE_AT_TARGET=2.0
OBSTACLE_CHECK_HZ=10
STOP_ID=1
OBJECT_ID=2

#  Obstacle avoidance 
OBSTACLE_DIST_CM=25
CLEAR_DIST_CM=20
STOP_PAUSE=1.0
TURN_CHECK_INTERVAL=0.15
MAX_TURN_TIME=20.0
MIN_TURN_TIME=1.0
AVOID_SPEED=30
STEER_CENTER=100
STEER_ADJUST=30

